@intrinsic("unreachable") fn trap();
@intrinsic("f32.floor") fn floor32(v: f32): f32;
@intrinsic("f64.ceil") fn ceil64(v: f64): f64;
fn assert[T](expected: T, actual: T) { if expected != actual { trap(); } }
fn id[T](v: T): T { return v; }

@main()
fn main() {
  let a: i8 = 127;
  a += 1;
  assert[i8](-128, a);
  assert[i64](-128, a as i64);
  a /= -1;
  assert[i8](-128, a);
  let b: u8 = 255;
  b += 2;
  assert[u8](1, b);
  b = ~b;
  assert[u8](254, b);
  let c: i16 = -32768;
  c -= 1;
  assert[i16](32767, c);
  let d: u16 = 65535;
  d += 2;
  assert[u16](1, d);
  let e: i32 = -2147483648;
  e -= 1;
  assert[i32](2147483647, e);
  let u: u32 = 4294967295;
  assert[bool](true, u > 1);
  assert[u64](4294967295, u as u64);
  u /= 2;
  assert[u32](2147483647, u);
  let big: u64 = 18446744073709551615;
  assert[bool](true, big > 1);
  assert[bool](true, big >= big);
  assert[bool](false, big < 1);
  assert[bool](false, big <= 1);
  assert[u64](6148914691236517205, big / 3);
  big += 1;
  assert[u64](0, big);
  let negative: i64 = -7;
  assert[i64](-3, negative / 2);
  assert[i64](-1, negative % 3);
  assert[i64](7, -negative);
  assert[i64](6, ~negative);
  assert[bool](true, negative < -1);
  assert[bool](true, negative <= -7);
  assert[bool](true, -1 > negative);
  assert[bool](true, -1 >= negative);
  let min: i64 = -9223372036854775808;
  assert[i64](0, min % -1);

  let shift: u16 = 40;
  let n: i64 = 1;
  assert[i64](1099511627776, n << shift);
  n <<= shift;
  assert[i64](1099511627776, n);
  let signed: i8 = -128;
  signed >>= 3 as i64;
  assert[i8](-16, signed);
  let small: u8 = 255;
  small >>= 4;
  assert[u8](15, small);
  let word: i32 = 1;
  word <<= 33;
  assert[i32](2, word);
  let bits: i64 = 10;
  bits |= 5;
  bits &= 7;
  bits ^= 3;
  assert[i64](4, bits);
  let native: usize = 1;
  native <<= 40;
  assert[usize](1099511627776, native);

  let x: f32 = 1.5;
  x *= 2.0;
  x += 1;
  x /= 2;
  x -= 0.5;
  assert[f32](1.5, x);
  assert[f32](-1.5, -x);
  assert[f64](1.5, x as f64);
  assert[f32](1.0, floor32(x));
  let y: f64 = -1.5;
  assert[f64](-1.0, ceil64(y));
  assert[f32](-1.5, y as f32);
  assert[i64](-1, y as i64);
  assert[u32](1, x as u32);
  assert[f64](-7.0, negative as f64);
  assert[f32](2147483648.0, u as f32);
  let decimal: f64 = 258.5;
  assert[u8](2, decimal as u8);
  let zero: f64 = 0.0;
  let nan = zero / zero;
  assert[bool](false, nan == nan);
  assert[bool](true, nan != nan);
  assert[bool](false, nan < zero);
  assert[bool](false, nan <= zero);
  assert[bool](false, nan > zero);
  assert[bool](false, nan >= zero);
  assert[f64](zero, -zero);
  assert[bool](true, x > 1.0 && x >= 1.5 && x < 2.0 && x <= 1.5);
  assert[bool](true, !false);
}
